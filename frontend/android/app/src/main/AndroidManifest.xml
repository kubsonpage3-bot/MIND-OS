<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- 1. Hero RPG Stats Widget (4x2 / 3x2) -->
        <receiver android:name=".RPGStatsWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mindos.app.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/rpg_stats_widget_info" />
        </receiver>

        <!-- 2. Today's Dailies Widget (3x2 / 4x2) -->
        <receiver android:name=".DailiesWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mindos.app.ACTION_UPDATE_DAILIES" />
                <action android:name="com.mindos.app.ACTION_TOGGLE_DAILY" />
                <action android:name="com.mindos.app.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/dailies_widget_info" />
        </receiver>

        <!-- 3. Daily Summary Widget (2x2 / 3x2) -->
        <receiver android:name=".DailySummaryWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mindos.app.ACTION_UPDATE_SUMMARY" />
                <action android:name="com.mindos.app.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/daily_summary_widget_info" />
        </receiver>

        <!-- 4. Quick Task Creator Widget (4x1) -->
        <receiver android:name=".QuickActionsWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mindos.app.ACTION_UPDATE_QUICK" />
                <action android:name="com.mindos.app.ACTION_UPDATE_WIDGET" />
                <action android:name="com.mindos.app.ACTION_UPDATE_DAILIES" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/quick_actions_widget_info" />
        </receiver>

        <!-- 5. Calendar Widget (agenda 2x2 / full month grid up to 4x4+) -->
        <receiver android:name=".CalendarWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mindos.app.ACTION_UPDATE_CALENDAR" />
                <action android:name="com.mindos.app.ACTION_CAL_NAV" />
                <action android:name="com.mindos.app.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- 6. Upcoming Widget: next events/deadlines over the coming days -->
        <receiver android:name=".UpcomingWidgetProvider"
            android:exported="true"
            android:permission="android.permission.BIND_APPWIDGET">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.mindos.app.ACTION_UPDATE_UPCOMING" />
                <action android:name="com.mindos.app.ACTION_UPDATE_WIDGET" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/upcoming_widget_info" />
        </receiver>

        <!-- Backs the Upcoming widget's scrollable ListView; must be
             BIND_REMOTEVIEWS-protected and unexported or the system refuses
             to bind it and the list silently stays empty. -->
        <service
            android:name=".UpcomingWidgetService"
            android:permission="android.permission.BIND_REMOTEVIEWS"
            android:exported="false" />

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local push notifications (required on Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Exact alarm for scheduled reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Receive boot broadcasts to reschedule notifications after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
</manifest>
