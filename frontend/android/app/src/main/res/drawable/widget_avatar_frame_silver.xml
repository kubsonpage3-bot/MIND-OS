<?xml version="1.0" encoding="utf-8"?>
<!-- Silver tier (ranks A/S); see widget_avatar_frame.xml (bronze). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3338BDF8" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1A1824" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2dp"
                android:color="#7DD3FC" />
        </shape>
    </item>
</layer-list>
