<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#23212F" />
            <corners android:radius="10dp" />
            <stroke
                android:width="1dp"
                android:color="#363248" />
        </shape>
    </item>
    <!-- Soft top highlight for a bit of glassy depth instead of a flat fill. -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#14FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</layer-list>
