<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_summary_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Top Streak & Header row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/widget_chip_dark"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center"
            android:layout_marginBottom="4dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_widget_flame"
                android:contentDescription="" />

            <TextView
                android:id="@+id/summary_streak_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 Day Streak"
                android:textColor="#FB923C"
                android:textSize="10sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Big Bold Done Number & Percentage -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/summary_done_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#C084FC"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/summary_total_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="/0"
                android:textColor="#64748B"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-bold"
                android:includeFontPadding="false"
                android:layout_marginStart="2dp" />

            <TextView
                android:id="@+id/summary_percent_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#22C55E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Label -->
        <TextView
            android:id="@+id/summary_done_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dailies Completed"
            android:textColor="#CBD5E1"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/summary_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginHorizontal="6dp"
            android:layout_marginBottom="6dp"
            android:progressDrawable="@drawable/summary_progress_drawable" />

        <!-- Subtitle Row: Left to do & Reset Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginHorizontal="6dp">

            <TextView
                android:id="@+id/summary_left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 left"
                android:textColor="#94A3B8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:typeface="monospace" />

            <TextView
                android:id="@+id/summary_reset_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • Reset 00:00"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:typeface="monospace" />
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>
