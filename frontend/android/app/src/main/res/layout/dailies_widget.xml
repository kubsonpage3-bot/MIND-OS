<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_dailies_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:clipToOutline="true">

    <!-- Header bar -->
    <RelativeLayout
        android:id="@+id/dailies_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <TextView
                android:id="@+id/dailies_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today's Dailies"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/dailies_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/0"
                android:textColor="#A855F7"
                android:textSize="11sp"
                android:typeface="monospace"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Plus Action Button -->
        <ImageButton
            android:id="@+id/dailies_btn_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/widget_chip_dark"
            android:src="@drawable/ic_widget_plus"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="Add Daily" />
    </RelativeLayout>

    <!-- Task List Column -->
    <LinearLayout
        android:id="@+id/dailies_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/dailies_header"
        android:orientation="vertical">

        <!-- Item 1 -->
        <LinearLayout
            android:id="@+id/daily_item_1"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/daily_check_1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_checkbox_bg"
                android:contentDescription="" />

            <TextView
                android:id="@+id/daily_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daily Task 1"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Item 2 -->
        <LinearLayout
            android:id="@+id/daily_item_2"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/daily_check_2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_checkbox_bg"
                android:contentDescription="" />

            <TextView
                android:id="@+id/daily_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daily Task 2"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Item 3 -->
        <LinearLayout
            android:id="@+id/daily_item_3"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/daily_check_3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_checkbox_bg"
                android:contentDescription="" />

            <TextView
                android:id="@+id/daily_text_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daily Task 3"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Item 4 -->
        <LinearLayout
            android:id="@+id/daily_item_4"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/daily_check_4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/widget_checkbox_bg"
                android:contentDescription="" />

            <TextView
                android:id="@+id/daily_text_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Daily Task 4"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Empty State -->
        <TextView
            android:id="@+id/dailies_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="✦ All Dailies Complete! ✦"
            android:textColor="#A855F7"
            android:textSize="12sp"
            android:typeface="monospace"
            android:visibility="visible" />
    </LinearLayout>
</RelativeLayout>
