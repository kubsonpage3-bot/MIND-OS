<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="6dp"
    android:gravity="center"
    android:clipToOutline="true">

    <!-- 1. Habit Button (Red) -->
    <LinearLayout
        android:id="@+id/quick_btn_habit"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp"
        android:background="@drawable/widget_btn_red"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_habit"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_cd_new_habit" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_habit"
            android:textAllCaps="true"
            android:textColor="#FCA5A5"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 2. Daily Button (Amber) -->
    <RelativeLayout
        android:id="@+id/quick_btn_daily"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp"
        android:background="@drawable/widget_btn_amber"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_widget_daily"
                android:scaleType="fitCenter"
                android:contentDescription="@string/widget_cd_new_daily" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_quick_daily"
                android:textAllCaps="true"
                android:textColor="#FDE68A"
                android:textSize="8sp"
                android:textStyle="bold"
                android:typeface="monospace"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/quick_daily_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="3dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:background="@drawable/widget_chip_dark"
            android:text="0"
            android:textColor="#F59E0B"
            android:textSize="7sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- 3. To-Do Button (Blue) -->
    <LinearLayout
        android:id="@+id/quick_btn_todo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="3dp"
        android:background="@drawable/widget_btn_blue"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_todo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_cd_new_todo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_todo"
            android:textAllCaps="true"
            android:textColor="#93C5FD"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 4. Chest / Shop Button (Purple) -->
    <LinearLayout
        android:id="@+id/quick_btn_chest"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@drawable/widget_btn_emerald"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_widget_chest"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_cd_open_chest" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_quick_chest"
            android:textAllCaps="true"
            android:textColor="#D8B4FE"
            android:textSize="8sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
