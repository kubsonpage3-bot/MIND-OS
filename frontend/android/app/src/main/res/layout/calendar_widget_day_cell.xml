<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated once per grid cell by CalendarWidgetService's RemoteViewsFactory;
     unlike the old hand-built grid, every cell reuses these SAME ids
     (no _N suffix), since the factory builds one fresh RemoteViews per
     position rather than one giant RemoteViews holding all 42 at once. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/day_cell_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_cal_cell_bg">

    <!-- Fixed-size square so widget_cal_today_circle renders as an actual
         circle (not stretched) and single vs. double-digit dates line up
         identically; gravity=center replaces relying on wrap_content. -->
    <TextView
        android:id="@+id/day_num"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="1"
        android:textColor="#E2E8F0"
        android:textSize="10.5sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:id="@+id/day_dots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="3dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <View
            android:id="@+id/day_dot_a"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_cal_dot" />

        <View
            android:id="@+id/day_dot_b"
            android:layout_width="4dp"
            android:layout_height="4dp"
            android:background="@drawable/widget_cal_dot"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
