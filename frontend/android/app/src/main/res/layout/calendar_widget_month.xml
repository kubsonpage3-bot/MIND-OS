<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cal_month_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp"
    android:clipToOutline="true">

    <!-- Header: month label + prev/next nav -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <ImageButton
            android:id="@+id/cal_btn_prev"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_chip_dark"
            android:src="@drawable/ic_widget_chevron_left"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_cd_prev_month" />

        <TextView
            android:id="@+id/cal_month_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="September 2026"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <ImageButton
            android:id="@+id/cal_btn_next"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_chip_dark"
            android:src="@drawable/ic_widget_chevron_right"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/widget_cd_next_month" />
    </RelativeLayout>

    <!-- Weekday header row: a plain static row, NOT part of the day grid
         below (that's now an adapter-driven GridView, see cal_grid). -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/weekday_hdr_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="M"
            android:textColor="#8B87A3"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weekday_hdr_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T"
            android:textColor="#8B87A3"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weekday_hdr_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="W"
            android:textColor="#8B87A3"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weekday_hdr_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="T"
            android:textColor="#8B87A3"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weekday_hdr_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="F"
            android:textColor="#8B87A3"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weekday_hdr_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S"
            android:textColor="#F472B6"
            android:textSize="9sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weekday_hdr_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="S"
            android:textColor="#F472B6"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 6-week day grid, populated by CalendarWidgetService's
         RemoteViewsFactory via setRemoteAdapter, NOT 42 hand-built
         FrameLayouts each carrying their own PendingIntent. That earlier
         approach could push a single RemoteViews update over the ~1MB
         Binder transaction limit (42 getActivity() PendingIntents is a lot
         of real IPC payload), which the launcher surfaces as "Problem
         loading widget" rather than any exception this app ever sees. A
         GridView adapter requests each cell's RemoteViews separately (small
         individual payloads) and every cell shares ONE PendingIntent
         template (see setPendingIntentTemplate in
         CalendarWidgetProvider#buildMonthGridViews); only the tapped date
         travels as a lightweight per-cell fill-in Intent. -->
    <GridView
        android:id="@+id/cal_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:numColumns="7"
        android:horizontalSpacing="0dp"
        android:verticalSpacing="0dp"
        android:stretchMode="columnWidth"
        android:gravity="fill" />

    <TextView
        android:id="@+id/cal_sync_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="@string/widget_calendar_tap_hint"
        android:textColor="#5B5773"
        android:textSize="8sp"
        android:visibility="gone" />

</LinearLayout>
