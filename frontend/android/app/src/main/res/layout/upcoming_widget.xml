<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/upcoming_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:clipToOutline="true">

    <!-- Header -->
    <TextView
        android:id="@+id/upcoming_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_upcoming_title"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="4dp" />

    <!-- Real scrolling list, backed by UpcomingWidgetService/RemoteViewsFactory.
         The month-grid's per-cell adapter attempt failed on a real device
         (see CalendarWidgetProvider's history) but that failure traced to a
         bare View element in the per-cell layout, not the adapter mechanism
         itself; this list's rows use only ImageView/TextView/LinearLayout,
         so the same class of failure doesn't apply here. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/upcoming_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/upcoming_empty_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_upcoming_empty"
            android:textColor="#A855F7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:typeface="monospace"
            android:padding="8dp" />
    </FrameLayout>
</LinearLayout>
