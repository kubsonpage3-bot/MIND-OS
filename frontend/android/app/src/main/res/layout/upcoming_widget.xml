                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upcoming_item_5"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/upcoming_dot_5"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_cal_dot" />

            <TextView
                android:id="@+id/upcoming_when_5"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#8B87A3"
                android:textSize="9sp"
                android:typeface="monospace"
                android:singleLine="true"
                android:ellipsize="end"
