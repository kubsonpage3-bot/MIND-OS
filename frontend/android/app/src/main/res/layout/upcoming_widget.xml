            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/upcoming_dot_3"
