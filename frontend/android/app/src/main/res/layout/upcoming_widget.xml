<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/upcoming_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp"
    android:clipToOutline="true">

    <!-- Header -->
    <TextView
        android:id="@+id/upcoming_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_upcoming_title"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <!-- Up to 6 fixed rows; not a true scrollable list. RemoteViews only
         gets real scrolling from a ListView/GridView backed by a
         RemoteViewsService adapter, and that exact mechanism just broke the
         Calendar widget's month grid on a real device in a way no build
         check here could catch (see CalendarWidgetProvider's history).
         Shipping a second, brand-new adapter-based widget in the same
         breath as fixing the first one was too much unverified risk at
         once, so this one is a fixed list instead, matching
         DailiesWidgetProvider's proven-reliable pattern. -->
    <LinearLayout
        android:id="@+id/upcoming_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/upcoming_item_1"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/upcoming_dot_1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_cal_dot" />

            <TextView
                android:id="@+id/upcoming_when_1"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#8B87A3"
                android:textSize="9sp"
                android:typeface="monospace"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/upcoming_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/upcoming_item_2"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_daily_item_bg"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/upcoming_dot_2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/widget_cal_dot" />

            <TextView
                android:id="@+id/upcoming_when_2"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:text="Today"
                android:textColor="#8B87A3"
                android:textSize="9sp"
                android:typeface="monospace"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="6dp" />

            <TextView
                android:id="@+id/upcoming_text_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Event"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:singleLine="true"
                android:ellipsize="end"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
